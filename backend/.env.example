APP_NAME="Job Application Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# 1. DATABASE: Supabase (PostgreSQL)
# ==============================================================================
# In Supabase: Project Settings -> Database -> Connection parameters
#
# Option A: Supabase Connection Pooler (Recommended - Port 5432 or 6543)
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# DB_SSLMODE=require
#
# Option B: Direct Connection
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# DB_SSLMODE=require
#
# Option C: Local Testing Fallback (No Supabase required)
# DB_CONNECTION=sqlite
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# 2. SUPABASE STORAGE (Screenshots & Documents)
# ==============================================================================
# In Supabase:
# - SUPABASE_URL: Project Settings -> API -> Project URL (e.g. https://xyz.supabase.co)
# - SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> Project API keys -> service_role (secret)
# - SUPABASE_STORAGE_BUCKET: Name of the bucket created under Supabase Storage (e.g. job-tracker-files)
# ==============================================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=job-tracker-files

# ==============================================================================
# 3. AI COMPANY AUTO-FILL (Google Gemini API)
# ==============================================================================
# Get a free API key at: https://aistudio.google.com/app/apikey
# ==============================================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ==============================================================================
# 4. FRONTEND CORS
# ==============================================================================
FRONTEND_URL=http://localhost:5173
